{
  "expo": {
    "name": "BazaarLink",
    "slug": "bazaarlink",
    "scheme": "bazaarlink",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.bazaarlink.app",
      "versionCode": 1
    }
  }
}
