{
  "name": "bazaarlink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:api": "node scripts/dev-api-with-ngrok.mjs",
    "dev:mobile": "pnpm --filter @bazaarlink/mobile exec expo start --tunnel --clear --go",
    "diagnose:mobile": "node scripts/diagnose-mobile-connection.mjs",
    "dev:admin": "pnpm --filter @bazaarlink/admin dev",
    "dev:storefront": "pnpm --filter @bazaarlink/storefront-web dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:health",
    "db:generate": "pnpm --filter @bazaarlink/database db:generate",
    "db:check": "pnpm --filter @bazaarlink/database db:check",
    "db:migrate": "pnpm --filter @bazaarlink/database db:migrate",
    "db:seed:demo": "pnpm --filter @bazaarlink/database seed:demo",
    "db:health": "pnpm --filter @bazaarlink/database db:health",
    "diagnose:cart-db": "pnpm --filter @bazaarlink/database diagnose:cart-db",
    "db:studio": "pnpm --filter @bazaarlink/database db:studio",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "verify:localization": "node scripts/verify-mobile-localization.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify:localization && pnpm verify:release-ux && pnpm test:api-dev && pnpm test:admin-login && pnpm test:expo-go && pnpm test:home-phase1 && pnpm test:home-phase2 && pnpm test:home-phase3 && pnpm test:home-phase4 && pnpm test:home-phase5 && pnpm test:home-phase6 && pnpm test:home-phase7 && pnpm test:home-phase8 && pnpm test:rtl-layout && pnpm test:account-phase1 && pnpm test:account-phase2 && pnpm test:account-phase3 && pnpm test:seller-plan-cards && pnpm test:seller-onboarding-selects && pnpm test:seller-map-hours && pnpm test:account-phase4 && pnpm test:account-phase5 && pnpm test:account-phase6 && pnpm test:account-phase7 && pnpm test:account-phase8 && pnpm test:marketplace-phase1 && pnpm test:marketplace-phase2 && pnpm test:marketplace-phase3 && pnpm test:marketplace-phase4 && pnpm test:marketplace-phase5 && pnpm test:marketplace-phase6 && pnpm test:marketplace-phase7 && pnpm test:marketplace-phase8 && pnpm test:product-detail-ui && pnpm test:wishlist-reliability && pnpm test:shopping-phase8 && pnpm test:shopping-cart-ui && pnpm test:cart-network-recovery && pnpm test:bodyless-http-headers && pnpm test:cart-server-incident && pnpm test:checkout-ui && pnpm test:checkout-load-recovery && pnpm test:loading-skeletons && pnpm test:expo-root-layout && pnpm build",
    "test:integration": "pnpm --filter @bazaarlink/api test:integration",
    "verify:release-ux": "node scripts/verify-release-ux.mjs",
    "release:preflight": "node scripts/production-preflight.mjs",
    "api:dev": "pnpm dev:api",
    "api:dev:server": "pnpm --filter @bazaarlink/api dev",
    "test:api-dev": "node --test scripts/dev-api-tunnel.test.mjs scripts/dev-api-command.test.mjs",
    "test:admin-login": "node --test scripts/admin-login.test.mjs",
    "test:expo-go": "node --test scripts/expo-go-compatibility.test.mjs",
    "test:home-phase1": "node --test scripts/home-phase1.test.mjs",
    "test:home-phase2": "node --test scripts/home-phase2.test.mjs",
    "test:home-phase3": "node --test scripts/home-phase3.test.mjs",
    "test:home-phase4": "node --test scripts/home-phase4.test.mjs",
    "test:home-phase5": "node --test scripts/home-phase5.test.mjs",
    "test:home-phase6": "node --test scripts/home-phase6.test.mjs",
    "test:home-phase7": "node --test scripts/home-phase7.test.mjs",
    "test:home-phase8": "node --test scripts/home-phase8.test.mjs",
    "test:rtl-layout": "node --test scripts/rtl-layout.test.mjs",
    "test:account-phase1": "node --test scripts/account-phase1.test.mjs",
    "test:account-phase2": "node --test scripts/account-phase2.test.mjs",
    "test:account-phase3": "node --test scripts/account-phase3.test.mjs",
    "test:seller-plan-cards": "node --test scripts/seller-onboarding-plan-cards.test.mjs",
    "test:seller-onboarding-selects": "node --test scripts/seller-onboarding-selects.test.mjs",
    "test:seller-map-hours": "node --test scripts/seller-map-hours.test.mjs",
    "test:account-phase4": "node --test scripts/account-phase4.test.mjs",
    "test:account-phase5": "node --test scripts/account-phase5.test.mjs",
    "test:account-phase6": "node --test scripts/account-phase6.test.mjs",
    "test:account-phase7": "node --test scripts/account-phase7.test.mjs",
    "test:account-phase8": "node --test scripts/account-phase8.test.mjs",
    "test:marketplace-phase1": "node --test scripts/marketplace-phase1.test.mjs",
    "test:marketplace-phase2": "node --test scripts/marketplace-phase2.test.mjs",
    "test:marketplace-phase3": "node --test scripts/marketplace-phase3.test.mjs",
    "test:marketplace-phase4": "node --test scripts/marketplace-phase4.test.mjs",
    "test:marketplace-phase5": "node --test scripts/marketplace-phase5.test.mjs",
    "test:marketplace-phase6": "node --test scripts/marketplace-phase6.test.mjs",
    "test:marketplace-phase7": "node --test scripts/marketplace-phase7.test.mjs",
    "test:marketplace-phase8": "node --test scripts/marketplace-phase8.test.mjs",
    "test:product-detail-ui": "node --test scripts/product-detail-ui.test.mjs",
    "test:wishlist-reliability": "node --test scripts/wishlist-reliability.test.mjs",
    "test:shopping-phase8": "node --test scripts/shopping-phase8.test.mjs",
    "test:shopping-cart-ui": "node --test scripts/shopping-cart-ui.test.mjs",
    "test:cart-network-recovery": "node --test scripts/cart-network-recovery.test.mjs",
    "test:bodyless-http-headers": "node --test scripts/bodyless-http-request-headers.test.mjs",
    "test:cart-server-incident": "node --test scripts/cart-server-incident.test.mjs",
    "test:checkout-ui": "node --test scripts/checkout-ui.test.mjs",
    "test:checkout-load-recovery": "node --test scripts/checkout-load-recovery.test.mjs",
    "test:loading-skeletons": "node --test scripts/loading-skeletons.test.mjs",
    "test:expo-root-layout": "node --test scripts/expo-router-root-layout.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
