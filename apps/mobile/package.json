{
  "name": "@bazaarlink/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.tsx",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "expo": "~57.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2"
  }
}
