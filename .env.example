NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bazaarlink
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_PREPARE_STATEMENTS=false

# Authentication
AUTH_SESSION_TTL_DAYS=30
AUTH_SESSION_TOUCH_INTERVAL_MINUTES=5

EXPO_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Phase 7 payments — HesabPay hosted checkout
# Keep HESABPAY_API_KEY server-side only. Never expose it as EXPO_PUBLIC_*.
HESABPAY_ENVIRONMENT=sandbox
HESABPAY_API_KEY=
HESABPAY_API_BASE_URL=https://api-sandbox.hesab.com
# Public HTTPS API origin used for hosted-checkout success/failure redirects.
# Example during local testing: https://your-ngrok-domain.ngrok-free.app
PAYMENT_PUBLIC_BASE_URL=
PAYMENT_PROVIDER_TIMEOUT_MS=12000
